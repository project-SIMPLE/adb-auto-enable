<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/ContentColumn"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Header: SIMPLE logo, title & refresh button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/logo_simple_desc"
                android:src="@drawable/logo_simple" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/refresh"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/text_primary" />
        </LinearLayout>

        <!-- Error Card: Missing WRITE_SECURE_SETTINGS -->
        <LinearLayout
            android:id="@+id/cardPermissionWarning"
            style="@style/Card"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_error_background"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/perm_error_title"
                android:textColor="@color/status_red"
                android:textSize="16sp"
                app:drawableStartCompat="@drawable/ic_error" />

            <TextView
                style="@style/CardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_error_desc" />

            <TextView
                android:id="@+id/textPermCommand"
                style="@style/CodeBox"
                android:text="@string/perm_grant_cmd"
                android:textColor="@color/status_red" />
        </LinearLayout>

        <!-- Warning Card: Inactive Accessibility Service -->
        <LinearLayout
            android:id="@+id/cardA11yWarning"
            style="@style/Card"
            android:background="@drawable/card_warning_background"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/a11y_warning_title"
                android:textColor="@color/status_amber"
                android:textSize="16sp"
                app:drawableStartCompat="@drawable/ic_warning" />

            <TextView
                style="@style/CardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/a11y_warning_desc" />

            <TextView
                android:id="@+id/textA11yCommand"
                style="@style/CodeBox"
                android:text="@string/a11y_enable_cmd"
                android:textColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenA11ySettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="44dp"
                android:text="@string/btn_open_a11y_settings"
                android:textSize="13sp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconSize="18dp" />
        </LinearLayout>

        <!-- Card: Controls & Status -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="20dp">

            <!-- Switch states come from the system settings: saveEnabled="false" keeps a
                 restored state from firing the listeners when the activity is recreated -->

            <!-- Control 1: Wireless ADB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adb_wireless_title" />

                        <TextView
                            android:id="@+id/badgeAdbStatus"
                            style="@style/StatusBadge"
                            android:background="@drawable/status_badge_green"
                            android:text="@string/status_enabled"
                            android:textColor="@color/status_green" />
                    </LinearLayout>

                    <TextView
                        style="@style/CardBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/adb_wireless_desc"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAdbWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:saveEnabled="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/card_stroke" />

            <!-- Control 2: Watchdog Service -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/watchdog_title" />

                        <TextView
                            android:id="@+id/badgeWatchdogStatus"
                            style="@style/StatusBadge"
                            android:background="@drawable/status_badge_green"
                            android:text="@string/status_running"
                            android:textColor="@color/status_green" />
                    </LinearLayout>

                    <TextView
                        style="@style/CardBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/watchdog_desc"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWatchdog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:saveEnabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card: Network & Ports -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/connection_info_title" />

                <ProgressBar
                    android:id="@+id/progressScanning"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/textDeviceIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/ip_address_label"
                android:drawablePadding="8dp"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_wifi"
                tools:text="192.168.1.50" />

            <LinearLayout
                android:id="@+id/layoutEndpointsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textNoEndpoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/scanning_ports"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <!-- Visible only when Termux is installed -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenTermux"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:text="@string/open_termux"
                android:textSize="13sp"
                android:visibility="gone"
                app:icon="@drawable/ic_terminal"
                app:iconSize="18dp"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Footer: project partners & version -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/partners_title" />

        <include layout="@layout/partners_strip" />

        <TextView
            android:id="@+id/textVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="ADB Auto-Enable 2.1.0 · Part of the SIMPLE project" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
